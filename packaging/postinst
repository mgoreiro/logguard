#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    install -d -m 755 /var/lib/logguard/archive
    # was-enabled defaults to true, so new installations run enable.
    deb-systemd-helper unmask logguard.timer >/dev/null || true
    if deb-systemd-helper --quiet was-enabled logguard.timer; then
        deb-systemd-helper enable logguard.timer >/dev/null || true
    else
        deb-systemd-helper update-state logguard.timer >/dev/null || true
    fi
    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        deb-systemd-invoke restart logguard.timer >/dev/null || true
    fi
fi

exit 0
