#!/bin/sh
set -e

if [ "$1" = "remove" ]; then
    if command -v deb-systemd-helper >/dev/null; then
        deb-systemd-helper mask logguard.timer >/dev/null || true
    fi
fi

if [ "$1" = "purge" ]; then
    if command -v deb-systemd-helper >/dev/null; then
        deb-systemd-helper purge logguard.timer >/dev/null || true
        deb-systemd-helper unmask logguard.timer >/dev/null || true
    fi
    rm -rf /var/lib/logguard
fi

if [ -d /run/systemd/system ]; then
    systemctl --system daemon-reload >/dev/null || true
fi

exit 0
